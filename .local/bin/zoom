#!/usr/bin/env bash

if [ "$XDG_CURRENT_DESKTOP" = "mango" ]; then
    MON=$(mmsg get focusing-client | jq -r '.monitor')
    SCALE=$(mmsg get monitor "$MON" | jq -r '.scale')
elif [ "$XDG_CURRENT_DESKTOP" = "somewm" ]; then
    MON=$(somewm-client --json screen focused | jq -r '.result' | awk -F'[{}=]' '{ print $5 }')
    SCALE=$(somewm-client --json screen scale 1 | jq -r '.result')
fi

grim -o "$MON" - | wayland-boomer -ms "$SCALE"
