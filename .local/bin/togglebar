#!/usr/bin/env bash

if pidof waybar >/dev/null 2>&1; then
    if killall waybar; then
        notify-send -a "togglebar" -u low -r 9992 "Status Bar" "OFF" -t 2000
    else
        notify-send -a "togglebar" -u crit -r 9992 "Status Bar" "FAILED to kill status bar" -t 2000
    fi
else
    if [ "$XDG_CURRENT_DESKTOP" = "hyprland" ]; then
        hyprctl dispatch 'hl.dsp.exec_cmd("waybar")'
        notify-send -a "togglebar" -u low -r 9992 "Status Bar" "ON" -t 2000
    elif [ "$XDG_CURRENT_DESKTOP" = "mango" ]; then
        if mmsg dispatch spawn,waybar >/dev/null 2>&1; then
            notify-send -a "togglebar" -u low -r 9992 "Status Bar" "ON" -t 2000
        else
            notify-send -a "togglebar" -u crit -r 9992 "Status Bar" "FAILED to START status bar" -t 2000
        fi
    fi
fi
