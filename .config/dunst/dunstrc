[global]
follow = keyboard
enable_posix_regex = true
width = (300, 500)
height = (75, 1000)
offset = (10, 10)
notification_limit = 10

progress_bar_min_width = 300
progress_bar_max_width = 500
progress_bar_height = 15
progress_bar_frame_width = 0

frame_width = 2
gap_size = 10

separator_color="#FFFFFF"

idle_threshold = "5s"
set_transient = no

font = "Iosevka Aile 10"
line_height = 2

icon_path = "/usr/share/pixmaps/"
enable_recursive_icon_lookup = true
dmenu = "/usr/sbin/rofi -dmenu "
default_icon = "/usr/share/pixmaps/archlinux-logo-kanagawa-dark.svg"
max_icon_size = 50
max_icon_size = 75
icon_position = right
markup = full

[experimental]
pause_on_mouse_over = true


[urgency_low]
foreground = "#1F1F28"
background = "#949FB5"
timeout = "10s"
highlight = "#1F1F28"
frame_color = "#363646"

[urgency_normal]
#foreground = "#DCD7BA"
#background = "#1F1F28"
#timeout = "20s"
#highlight = "#DCD7BA"
#frame_color = "#C8C093"

foreground = "#1F1F28"
background = "#DCD7BA"
timeout = "20s"
highlight = "#1F1F28"
frame_color = "#363646"

[urgency_critical]
foreground = "#1F1F28"
background = "#FF5D62"
timeout = "0"
highlight = "#1F1F28"
frame_color = "#363646"
